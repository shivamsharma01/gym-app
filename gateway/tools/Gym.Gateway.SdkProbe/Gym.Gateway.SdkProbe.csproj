<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Gym.Gateway.SdkProbe</RootNamespace>
    <AssemblyName>Gym.Gateway.SdkProbe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym.Gateway.Adapters\Gym.Gateway.Adapters.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\native\win-x64\*.dll" CopyToOutputDirectory="PreserveNewest" Link="native\win-x64\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
