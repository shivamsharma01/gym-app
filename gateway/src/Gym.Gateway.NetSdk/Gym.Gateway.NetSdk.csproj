<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NetSDKCS</RootNamespace>
    <AssemblyName>Gym.Gateway.NetSdk</AssemblyName>
    <DefineConstants>$(DefineConstants);WINDOWS_X64</DefineConstants>
    <!-- Vendor code is .NET Framework 4.0 era; do not treat its warnings as errors. -->
    <WarningLevel>1</WarningLevel>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0649;CS1591;CS8981</NoWarn>
  </PropertyGroup>
</Project>
