# Production HTTPS edge (copy over nginx.conf on the VPS after certificates exist).
# Example:
#   certbot certonly --webroot -w /var/www/certbot -d gym.kainazi.co.in -d gym.heavyreps.in
#
# Mount certs into the edge container, e.g.:
#   /etc/letsencrypt:/etc/letsencrypt:ro

upstream gym_backend {
    server backend:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name
        gym.kainazi.co.in
        gym.heavyreps.in
        mcart.space
        api.mcart.space;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name
        gym.kainazi.co.in
        gym.heavyreps.in
        mcart.space
        api.mcart.space;

    # Adjust paths to match certbot / your issuer layout
    ssl_certificate     /etc/letsencrypt/live/gym.kainazi.co.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gym.kainazi.co.in/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass http://gym_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Gym-Slug $http_x_gym_slug;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header Authorization $http_authorization;
    }

    location /live {
        proxy_pass http://gym_backend/live;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }

    location /gateway {
        proxy_pass http://gym_backend/gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }

    location /actuator/ {
        proxy_pass http://gym_backend/actuator/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
        proxy_set_header X-Request-Id $http_x_request_id;
    }

    location / {
        default_type application/json;
        return 404 '{"error":"NOT_FOUND","message":"API host — SPA is served elsewhere"}';
    }
}
