# Production SaaS builds: leave unset (empty) so the SPA uses same-origin relative paths:
#   /api/*, /actuator/*, wss://<current-host>/live
# Cloudflare (or equivalent) must proxy those paths to the VPS Nginx → Spring Boot.
#
# Local development: leave unset; Vite proxies /api, /live, /actuator to http://127.0.0.1:8080.
#
# Optional override only for special tooling (never bake a customer API hostname into prod):
# VITE_API_BASE=https://example.invalid
VITE_API_BASE=
