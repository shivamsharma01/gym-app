# syntax=docker/dockerfile:1
# Multi-stage build for gym-backend (Spring Boot 4 / Java 21).
# Build context: repository root.
FROM maven:3.9.9-eclipse-temurin-21-alpine AS build
WORKDIR /workspace
COPY backend/pom.xml ./
COPY backend/src ./src
RUN mvn -q -DskipTests package \
  && mv target/gym-backend-*.jar /workspace/app.jar

FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache wget \
  && addgroup -S gym && adduser -S gym -G gym
COPY --from=build /workspace/app.jar /app/app.jar
USER gym
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0"
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
  CMD wget -qO- http://127.0.0.1:8080/actuator/health/liveness | grep -q UP || exit 1
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
