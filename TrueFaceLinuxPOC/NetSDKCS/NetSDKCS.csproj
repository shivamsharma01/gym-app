<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);LINUX;LINUX_X64</DefineConstants>
    <RootNamespace>NetSDKCS</RootNamespace>
    <AssemblyName>NetSDKCS</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Vendor code is .NET Framework 4.0 era; do not treat its warnings as errors. -->
    <WarningLevel>1</WarningLevel>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0649;CS1591;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrueFaceLinuxPOC" />
    <InternalsVisibleTo Include="TrueFaceLinuxPOC.Tests" />
  </ItemGroup>
</Project>
