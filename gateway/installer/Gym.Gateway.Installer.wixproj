<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.5.0</ProductVersion>
    <GatewayPublishDir Condition="'$(GatewayPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\win-x64\</GatewayPublishDir>
    <!-- Compile-time path for Package.wxs $(PublishDir) — do not use !(bindpath.*) on File/@Source -->
    <PublishDir>$([System.IO.Path]::GetFullPath('$(GatewayPublishDir)'))\</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
