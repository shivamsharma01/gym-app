# Copy to .env and adjust. NEVER commit real secrets. Values here are safe local defaults.

# Active Spring profile (dev enables the demo data seeder)
SPRING_PROFILES_ACTIVE=dev

# Database (matches deploy/docker-compose.yml)
DB_URL=jdbc:mysql://localhost:3306/gym?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=gym
DB_PASSWORD=gym

# Server
SERVER_PORT=8080

# Security — GENERATE A STRONG SECRET (>= 32 bytes) for anything beyond local dev, e.g.:
#   openssl rand -base64 48
APP_SECURITY_JWT_SECRET=dev-only-insecure-secret-change-me-0123456789-0123456789
APP_JWT_ACCESS_TTL=PT15M
APP_JWT_REFRESH_TTL=P7D

# CORS — comma-separated allowed origins for the SPA (Vite + local Docker SPA)
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088,http://localhost:4173,http://127.0.0.1:4173

# Device gateway — optional deployment-wide handshake token. Prefer the per-gateway token
# returned once by POST /api/v1/gateways. Never put device/SDK passwords here.
APP_GATEWAY_SHARED_TOKEN=
APP_GATEWAY_OUTBOX_DISPATCHER_ENABLED=true
# In-process mock gateway (NOT hardware). Leave false unless running without a LAN agent.
APP_GATEWAY_SIMULATOR_ENABLED=false

