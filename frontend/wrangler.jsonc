{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-app",
  "main": "./worker.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  // Required for `wrangler preview` (Workers Previews). Production settings stay top-level.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/actuator/*",
      "/live",
      "/live/*",
      "/gateway",
      "/gateway/*"
    ]
  }
}
