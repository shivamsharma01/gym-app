# ---- Build outputs -------------------------------------------------------------------------------
backend/target/
**/bin/
**/obj/
**/.vs/

# ---- Secrets / environment -----------------------------------------------------------------------
.env
**/.env
*.env.local

# ---- Vendor native SDK binaries ------------------------------------------------------------------
# Large, vendor-provided binaries are provisioned out-of-band (see docs/device-sdk.md),
# not tracked in git. Source (*.cs, *.csproj, *.sln) IS tracked.
*.dll
*.so
*.so.*
*.lib
*.exe
*.pdb

# Exception: TrueFace Linux POC ships the exact lin64 .so set so a gym-LAN
# machine can clone and run without a separate Dahua SDK pack.
!TrueFaceLinuxPOC/Native/*.so

# Exception: Phase 4 Windows Device Gateway ships the demo's win-x64 DLLs so a
# gym Windows PC can run without hunting through TrueFace_SDK/bin.
!gateway/native/win-x64/*.dll

# ---- Logs / runtime ------------------------------------------------------------------------------
*.log
**/sdk_log/
*.cache
*.Up2Date
*.CopyComplete

# ---- IDE / OS ------------------------------------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
/.metadata/
.classpath
.factorypath
.project
.settings