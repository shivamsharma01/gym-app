# Copy to deploy/.env and fill in. Never commit deploy/.env.
#
#   cp deploy/.env.example deploy/.env
#   openssl rand -base64 48   # → APP_SECURITY_JWT_SECRET
#
# Defaults below target a single Linux VPS (~4 GB RAM) running MySQL + API + Nginx.
# Scale vertically by raising BACKEND_MEMORY_LIMIT / MYSQL_* / DB_POOL_MAX / JAVA_OPTS.

# --- Image tagging (optional) ---
IMAGE_TAG=local

# --- MySQL ---
MYSQL_DATABASE=gym
MYSQL_USER=gym
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# Bound to 127.0.0.1 only (see compose). Change port if 3306 is taken on the host.
MYSQL_HOST_PORT=3306
# Vertical scale (passed to mysqld + container limits)
MYSQL_MAX_CONNECTIONS=100
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MEMORY_LIMIT=1g
MYSQL_MEMORY_RESERVATION=256m
MYSQL_CPUS=1.0

# --- API edge (nginx) ---
EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
EDGE_MEMORY_LIMIT=128m
EDGE_CPUS=0.5

# Backend published on loopback for debug/tunnels; public traffic uses the edge.
BACKEND_PORT=127.0.0.1:8080

# Optional local SPA profile only (--profile spa)
FRONTEND_PORT=8088

# --- Backend (Spring) ---
# MUST be prod on the VPS. Use "dev" only on a laptop with backend/.env.
SPRING_PROFILES_ACTIVE=prod

# HikariCP — sized for a small multi-tenant SaaS; raise with backend RAM if needed.
# Rule of thumb: DB_POOL_MAX ≤ (MySQL max_connections − headroom) / number of API replicas.
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Container memory for the JVM (MaxRAMPercentage applies to this limit).
BACKEND_MEMORY_LIMIT=2g
BACKEND_MEMORY_RESERVATION=512m
BACKEND_CPUS=2.0
# Optional override (compose already sets a sensible default):
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# First boot under prod only — then REMOVE and recreate backend:
# APP_BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-strong-password
# APP_BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
# APP_BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@platform.local

APP_SECURITY_JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
APP_JWT_ACCESS_TTL=PT15M
APP_JWT_REFRESH_TTL=P7D

# Same-origin production SPA does not need CORS entries.
# Keep localhost for Vite; add origins only for intentional cross-origin clients.
APP_CORS_ORIGINS=http://localhost:5173

# SPA production build: leave VITE_API_BASE unset/empty (same-origin /api and /live).

# Optional deployment-wide gateway handshake; prefer per-gateway tokens from the UI.
APP_GATEWAY_SHARED_TOKEN=
APP_GATEWAY_OUTBOX_DISPATCHER_ENABLED=true
# Never true in production — in-process mock is not hardware.
APP_GATEWAY_SIMULATOR_ENABLED=false

# Public site: leave empty for /g/{slug}. Set apex domain for {slug}.example.com.
APP_PUBLIC_TENANT_SLUG=
APP_PUBLIC_BASE_DOMAIN=

# In-memory rate limits (single node — add CDN/WAF limits for multi-node)
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_LOGIN_PER_MINUTE=20
APP_RATE_LIMIT_REFRESH_PER_MINUTE=30
APP_RATE_LIMIT_ENQUIRY_PER_MINUTE=10
APP_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
APP_RATE_LIMIT_REPORTS_PER_MINUTE=30
APP_RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=10
